DATABASE_URL=postgresql://smiley:smiley@localhost:5432/smiley?schema=public
REDIS_URL=redis://localhost:6379
PORT=3000
NODE_ENV=development
# In production, CORS_ORIGIN must list explicit origin(s); wildcard "*" is
# rejected at startup. Supports a comma-separated list, e.g.:
# CORS_ORIGIN=https://app.example.com,https://admin.example.com
CORS_ORIGIN=http://localhost:8080
# In production, JWT secrets must be >= 32 chars and must not be a known default,
# otherwise the server refuses to start. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
BCRYPT_COST=12
PASSWORD_RESET_DEBUG_TOKEN=false
AUTH_DEBUG_TOKENS=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
STORAGE_SIGNED_URL_TTL_SECONDS=900
# Per-media-type upload ceilings (bytes). Defaults: image 10MB, audio 40MB,
# video 3GB. STORAGE_MAX_UPLOAD_BYTES is the fallback for other types (e.g. PDF).
STORAGE_MAX_IMAGE_BYTES=10485760
STORAGE_MAX_AUDIO_BYTES=41943040
STORAGE_MAX_VIDEO_BYTES=3221225472
STORAGE_MAX_UPLOAD_BYTES=26214400
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
PUSH_TOKEN_ENCRYPTION_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
SENTRY_DSN=
LOG_LEVEL=info
